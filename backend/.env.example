GITHUB_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Model for job-description and project-report extraction (small calls; default gemini-3.5-flash-lite).
GEMINI_JD_MODEL=gemini-3.5-flash-lite
# Scanned certificate and report OCR uses the local Tesseract executable (must be on PATH).
# Override with development only for local use. Other environments require recruiter authentication.
APP_ENV=production
# Comma-separated frontend URLs allowed to call the API (add your Vercel URL when deploying)
FRONTEND_ORIGINS=http://localhost:5173
# Comma-separated IPs of trusted reverse proxies; only then is X-Forwarded-For used.
TRUSTED_PROXY_IPS=
# Outside development: named recruiter keys (each 32+ characters), e.g. {"reviewer-alice":"<random>"}.
RECRUITER_ACCOUNTS=
# Optional local-development key. Leave unset in production.
RECRUITER_KEY=
# Target roles from a pasted job description (default true; false hides the option).
ENABLE_CUSTOM_ROLES=true
# Project reports and a portfolio URL as extra sources (default true; false ignores and hides them).
ENABLE_REPORTS=true
# SQL evidence depth score (default true; false skips computing it and hides it everywhere).
ENABLE_SQL_DEPTH=true
ENABLE_SKILL_DEPTH=true

# Optional shared read-only recruiter account, disabled by default.
# Setting this to the displayed preset password grants shared access to real submissions.
PRESET_RECRUITER_PASSWORD=
